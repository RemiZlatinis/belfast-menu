PAYLOAD_SECRET=change-me-to-32+random-chars-min
DATABASE_URI=file:./belfast.db
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# First admin (created automatically on first local boot if no users exist)
PAYLOAD_FIRST_USER_EMAIL=admin@belfast.pub
PAYLOAD_FIRST_USER_PASSWORD=admin123

# Deploy Hook for the /admin "Deploy site" button (Vercel → Settings → Git → Deploy Hooks).
# Required in production when using persistent CMS; never commit the real URL.
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
