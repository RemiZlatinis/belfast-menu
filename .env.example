PAYLOAD_SECRET=change-me-to-32+random-chars-min
DATABASE_URI=file:./belfast.db
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# First admin (created automatically on first local boot if no users exist)
PAYLOAD_FIRST_USER_EMAIL=admin@belfast.pub
PAYLOAD_FIRST_USER_PASSWORD=admin123

# Deploy Hook for the /admin "Deploy site" button (Vercel → Settings → Git → Deploy Hooks).
# Required in production when using persistent CMS; never commit the real URL.
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...

# ---- Vercel production (persistent CMS via Neon Postgres) ----
# 1. Vercel → Storage → Create Neon Postgres (DATABASE_URL is injected automatically).
# 2. Set PAYLOAD_SECRET (min 32 chars — build FAILS with a persistent DB and no secret).
# 3. Set NEXT_PUBLIC_SERVER_URL to the canonical https://your-app.vercel.app URL.
# 4. Redeploy, visit /admin to create the owner, edit Menus, hit "Deploy site".
# Without DATABASE_URL the build bakes the static seed (zero-env deploy, CMS edits don't persist).
# DATABASE_URL=postgresql://...
# PAYLOAD_SECRET=set-a-long-random-secret-min-32-chars
# NEXT_PUBLIC_SERVER_URL=https://your-app.vercel.app
